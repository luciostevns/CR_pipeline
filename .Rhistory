filter(Matched) |>
group_by(IEDB_Protein_ID) |>
summarise(n = n()) |>
arrange(n)
match_df |>
filter(Matched) |>
group_by(IEDB_Protein_ID) |>
summarise(n = n()) |>
arrange(desc(n))
match_df |>
filter(Matched) |>
group_by(IEDB_Protein_ID) |>
summarise(n = n(),
Epitope_Source) |>
arrange(desc(n))
match_df |>
filter(Matched) |>
group_by(IEDB_Protein_ID) |>
summarise(n = n(),
n_distinct(Epitope_Source)) |>
arrange(desc(n))
match_df |>
filter(Matched) |>
group_by(IEDB_Protein_ID) |>
summarise(n = n(),
unique(Epitope_Source)) |>
arrange(desc(n))
match_df |>
